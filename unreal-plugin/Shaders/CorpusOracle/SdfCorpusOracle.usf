StructuredBuffer<float4> Points;
RWStructuredBuffer<float> Distances;
uint PointCount;

[numthreads(64, 1, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (DispatchThreadId.x >= PointCount)
	{
		return;
	}
	Distances[DispatchThreadId.x] = sdf_eval(Points[DispatchThreadId.x].xyz);
}
