float3 quat_rotate(float3 v, float4 q) {
    precise float3 t = 2.0 * cross(q.xyz, v);
    precise float3 alice_r = v + q.w * t + cross(q.xyz, t);
    return alice_r;
}
float sdf_pyramid(float3 p, float h) {
    precise float ht = h * 2.0;
    precise float m2 = ht * ht + 0.25;
    precise float py = p.y + h;
    precise float px = abs(p.x);
    precise float pz = abs(p.z);
    if (pz > px) { precise float tmp = px; px = pz; pz = tmp; }
    px -= 0.5;
    pz -= 0.5;
    precise float qx = pz;
    precise float qy = ht * py - 0.5 * px;
    precise float qz = ht * px + 0.5 * py;
    precise float s = max(-qx, 0.0);
    precise float t = clamp((qy - 0.5 * pz) / (m2 + 0.25), 0.0, 1.0);
    precise float a = m2 * (qx + s) * (qx + s) + qy * qy;
    precise float b = m2 * (qx + 0.5 * t) * (qx + 0.5 * t) + (qy - m2 * t) * (qy - m2 * t);
    precise float d2 = (min(-qx * m2 - qy * 0.5, qy) > 0.0) ? 0.0 : min(a, b);
    precise float alice_r = sqrt((d2 + qz * qz) / m2) * (max(qz, -py) < 0.0 ? -1.0 : 1.0);
    return alice_r;
}

float sdf_eval(float3 p) {
    precise float3 d0 = quat_rotate(p, float4(-0.0, 0.9995736, -0.0, -0.029199546));
    precise float d1 = sdf_pyramid(d0, 0.75);
    return d1;
}
