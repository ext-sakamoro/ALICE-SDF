// GENERATED by examples/unreal_corpus_oracle.rs from tests/common/corpus.rs — do not edit
// corpus node `parabola_segment`: HlslShader::transpile(.., Hardcoded)
float sdf_parabola_segment(float3 p, float w, float ph, float hd) {
    precise float px = abs(p.x);
    precise float py = p.y;
    precise float ww_sq = w * w;
    precise float y_arch = ph * (1.0 - px * px / ww_sq);
    bool is_in = (px <= w && py >= 0.0 && py <= y_arch);
    precise float t = clamp(px, 0.0, w);
    for (int i = 0; i < 8; i++) {
        precise float ft = ph * (1.0 - t * t / ww_sq);
        precise float dft = -2.0 * ph * t / ww_sq;
        precise float ex = px - t;
        precise float ey = py - ft;
        precise float f = -ex + ey * dft;
        precise float df = 1.0 + dft * dft + ey * (-2.0 * ph / ww_sq);
        if (abs(df) > 1e-10) { t = clamp(t - f / df, 0.0, w); }
    }
    precise float cy = ph * (1.0 - t * t / ww_sq);
    precise float d_para = length(float2(px - t, py - cy));
    precise float d_base = (px <= w) ? abs(py) : length(float2(px - w, py));
    precise float d_unsigned = min(d_para, d_base);
    precise float d2d = is_in ? -d_unsigned : d_unsigned;
    precise float dz = abs(p.z) - hd;
    precise float2 ext = max(float2(d2d, dz), float2(0.0, 0.0));
    precise float alice_r = min(max(d2d, dz), 0.0) + length(ext);
    return alice_r;
}

float sdf_eval(float3 p) {
    precise float d0 = sdf_parabola_segment(p, 0.5, 0.4, 0.1);
    return d0;
}
