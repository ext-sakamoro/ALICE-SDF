// GENERATED by examples/unreal_corpus_oracle.rs from tests/common/corpus.rs — do not edit
// corpus node `uneven_capsule`: HlslShader::transpile(.., Hardcoded)
float sdf_uneven_capsule(float3 p, float r1, float r2, float ch, float hd) {
    precise float px = abs(p.x);
    precise float hh = ch * 2.0;
    precise float b = (r1 - r2) / hh;
    precise float a = sqrt(max(1.0 - b * b, 0.0));
    precise float k = dot(float2(-b, a), float2(px, p.y));
    precise float d2d;
    if (k < 0.0) {
        d2d = length(float2(px, p.y)) - r1;
    } else if (k > a * hh) {
        d2d = length(float2(px, p.y - hh)) - r2;
    } else {
        d2d = dot(float2(px, p.y), float2(a, b)) - r1;
    }
    precise float dz = abs(p.z) - hd;
    precise float2 ww = max(float2(d2d, dz), float2(0.0, 0.0));
    precise float alice_r = min(max(d2d, dz), 0.0) + length(ww);
    return alice_r;
}

float sdf_eval(float3 p) {
    precise float d0 = sdf_uneven_capsule(p, 0.3, 0.2, 0.25, 0.1);
    return d0;
}
