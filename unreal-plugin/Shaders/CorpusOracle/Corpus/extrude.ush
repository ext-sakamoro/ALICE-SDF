float sdf_eval(float3 p) {
    float3 d0 = float3(p.x, p.y, 0.0);
    float d1_d2d = length(d0.xy) - 0.4;
    float d1_dz = abs(d0.z) - 1.0;
    float d1_wx = max(d1_d2d, 0.0);
    float d1_wy = max(d1_dz, 0.0);
    float d1 = sqrt(d1_wx*d1_wx + d1_wy*d1_wy) + min(max(d1_d2d, d1_dz), 0.0);
    float2 d3 = float2(d1, abs(p.z) - 0.15);
    float d2 = min(max(d3.x, d3.y), 0.0) + length(max(d3, float2(0.0, 0.0)));
    return d2;
}
