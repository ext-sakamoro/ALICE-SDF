// GENERATED by examples/unreal_corpus_oracle.rs from tests/common/corpus.rs — do not edit
// corpus node `rounded_cylinder`: HlslShader::transpile(.., Hardcoded)
float sdf_rounded_cylinder(float3 p, float r, float rr, float h) {
    float2 d = float2(length(p.xz) - r + rr, abs(p.y) - h);
    return min(max(d.x, d.y), 0.0) + length(max(d, float2(0.0, 0.0))) - rr;
}

float sdf_eval(float3 p) {
    float d0 = sdf_rounded_cylinder(p, 0.4, 0.1, 0.25);
    return d0;
}
