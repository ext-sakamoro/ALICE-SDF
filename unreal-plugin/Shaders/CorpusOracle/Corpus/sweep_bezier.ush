// GENERATED by examples/unreal_corpus_oracle.rs from tests/common/corpus.rs — do not edit
// corpus node `sweep_bezier`: HlslShader::transpile(.., Hardcoded)
float bezier_distance_2d(float2 q, float2 p0, float2 p1, float2 p2) {
    precise float2 a = p1 - p0;
    precise float2 b = p0 - p1 * 2.0 + p2;
    precise float2 c = a * 2.0;
    precise float2 d = p0 - q;
    precise float bb = dot(b, b);
    if (bb < 1e-12) {
        precise float2 ac = p2 - p0;
        precise float t = clamp(-dot(d, ac) / max(dot(ac, ac), 1e-12), 0.0, 1.0);
        precise float alice_r = length(d + ac * t);
        return alice_r;
    }
    precise float kk = 1.0 / bb;
    precise float kx = kk * dot(a, b);
    precise float ky = kk * (2.0 * dot(a, a) + dot(d, b)) / 3.0;
    precise float kz = kk * dot(d, a);
    precise float p = ky - kx * kx;
    precise float p3 = p * p * p;
    precise float qq = kx * (2.0 * kx * kx - 3.0 * ky) + kz;
    precise float h = qq * qq + 4.0 * p3;
    precise float res;
    if (h >= 0.0) {
        precise float hs = sqrt(h);
        precise float x0 = (hs - qq) * 0.5;
        precise float x1 = (-hs - qq) * 0.5;
        precise float u = sign(x0) * pow(abs(x0), 1.0 / 3.0);
        precise float v = sign(x1) * pow(abs(x1), 1.0 / 3.0);
        precise float t = clamp(u + v - kx, 0.0, 1.0);
        precise float2 e = d + (c + b * t) * t;
        res = dot(e, e);
    } else {
        precise float z = sqrt(-p);
        precise float v = acos(clamp(qq / (p * z * 2.0), -1.0, 1.0)) / 3.0;
        precise float m = cos(v);
        precise float n = sin(v) * 1.7320508;
        precise float t0 = clamp((m + m) * z - kx, 0.0, 1.0);
        precise float t1 = clamp((-n - m) * z - kx, 0.0, 1.0);
        precise float2 e0 = d + (c + b * t0) * t0;
        precise float2 e1 = d + (c + b * t1) * t1;
        res = min(dot(e0, e0), dot(e1, e1));
    }
    precise float alice_r = sqrt(res);
    return alice_r;
}

float sdf_eval(float3 p) {
    precise float3 d1 = float3(bezier_distance_2d(float2(p.x, p.z), float2(-1.0, 0.0), float2(0.0, 1.0), float2(1.0, 0.0)), p.y, 0.0);
    precise float d2 = length(d1) - 0.6;
    precise float d0 = d2;
    return d0;
}
