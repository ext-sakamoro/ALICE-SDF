// GENERATED by examples/unreal_corpus_oracle.rs from tests/common/corpus.rs — do not edit
// corpus node `cut_hollow_sphere`: HlslShader::transpile(.., Hardcoded)
float sdf_cut_hollow_sphere(float3 p, float r, float h, float t) {
    float w = sqrt(max(r * r - h * h, 0.0));
    float2 q = float2(length(p.xz), p.y);
    if (h * q.x < w * q.y) return length(q - float2(w, h)) - t;
    return abs(length(q) - r) - t;
}

float sdf_eval(float3 p) {
    float d0 = sdf_cut_hollow_sphere(p, 0.6, 0.2, 0.05);
    return d0;
}
