// GENERATED by examples/unreal_corpus_oracle.rs from tests/common/corpus.rs — do not edit
// corpus node `blobby_cross`: HlslShader::transpile(.., Hardcoded)
float sdf_blobby_cross(float3 p, float size, float hh) {
    const float he = 0.5;
    precise float2 pos = abs(float2(p.x, p.z) / size);
    pos = float2(abs(pos.x - pos.y), 1.0 - pos.x - pos.y) * 0.70710678;
    precise float pp = (he - pos.y - 0.25 / he) / (6.0 * he);
    precise float q = pos.x / (he * he * 16.0);
    precise float h = q * q - pp * pp * pp;
    precise float x;
    if (h >= 0.0) {
        // the cube root of q - r (which cancels near the arm tips) is pp / u: (q - r)(q + r) = pp^3
        precise float u = pow(q + sqrt(h), 1.0 / 3.0);
        x = 0.0;
        if (u > 0.0) { x = u + pp / u; }
    } else {
        precise float r = sqrt(pp);
        x = 2.0 * r * cos(acos(q / (pp * r)) / 3.0);
    }
    x = min(x, 0.70710678);
    precise float2 z = float2(x, he * (1.0 - 2.0 * x * x)) - pos;
    precise float d_2d = length(z) * sign(z.y) * size;
    precise float d_y = abs(p.y) - hh;
    precise float2 w = float2(max(d_2d, 0.0), max(d_y, 0.0));
    precise float alice_r = min(max(d_2d, d_y), 0.0) + length(w);
    return alice_r;
}

float sdf_eval(float3 p) {
    precise float d0 = sdf_blobby_cross(p, 0.6, 0.1);
    return d0;
}
