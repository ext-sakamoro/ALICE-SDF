// GENERATED by examples/unreal_corpus_oracle.rs from tests/common/corpus.rs — do not edit
// corpus node `superellipsoid`: HlslShader::transpile(.., Hardcoded)
float sdf_superellipsoid(float3 p, float hx, float hy, float hz, float e1, float e2) {
    precise float qx = max(abs(p.x / hx), 0.00001);
    precise float qy = max(abs(p.y / hy), 0.00001);
    precise float qz = max(abs(p.z / hz), 0.00001);
    precise float ee1 = max(e1, 0.02);
    precise float ee2 = max(e2, 0.02);
    precise float m1 = 2.0 / ee2;
    precise float m2 = 2.0 / ee1;
    precise float w = pow(qx, m1) + pow(qz, m1);
    precise float v = pow(w, ee2 / ee1) + pow(qy, m2);
    precise float f = pow(v, ee1 * 0.5);
    precise float alice_r = (f - 1.0) * min(hx, min(hy, hz)) * 0.5;
    return alice_r;
}

float sdf_eval(float3 p) {
    precise float d0 = sdf_superellipsoid(p, 0.25, 0.2, 0.15, 0.8, 1.2);
    return d0;
}
