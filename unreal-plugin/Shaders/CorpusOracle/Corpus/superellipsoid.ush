// GENERATED by examples/unreal_corpus_oracle.rs from tests/common/corpus.rs — do not edit
// corpus node `superellipsoid`: HlslShader::transpile(.., Hardcoded)
float sdf_superellipsoid(float3 p, float hx, float hy, float hz, float e1, float e2) {
    float qx = max(abs(p.x / hx), 0.00001);
    float qy = max(abs(p.y / hy), 0.00001);
    float qz = max(abs(p.z / hz), 0.00001);
    float ee1 = max(e1, 0.02);
    float ee2 = max(e2, 0.02);
    float m1 = 2.0 / ee2;
    float m2 = 2.0 / ee1;
    float w = pow(qx, m1) + pow(qz, m1);
    float v = pow(w, ee2 / ee1) + pow(qy, m2);
    float f = pow(v, ee1 * 0.5);
    return (f - 1.0) * min(hx, min(hy, hz)) * 0.5;
}

float sdf_eval(float3 p) {
    float d0 = sdf_superellipsoid(p, 0.25, 0.2, 0.15, 0.8, 1.2);
    return d0;
}
