float alice_smin_quartic(float a, float b, float k) {
    precise float m = min(a, b);
    precise float r = m;
    if (k > 0.0) {
        precise float x = abs(a - b);
        precise float h = max(1.0 - x * (1.0 / k), 0.0);
        precise float d = h * h * h * (4.0 - h) * (k * 0.0625);
        r = m - d;
    }
    return r;
}

float sdf_eval(float3 p) {
    precise float d0 = length(p) - 0.6;
    precise float3 d1 = p - float3(0.8, 0.0, 0.0);
    precise float d2 = length(d1) - 0.5;
    precise float d3 = -alice_smin_quartic(-d0, -d2, 0.3);
    return d3;
}
