// GENERATED by examples/unreal_corpus_oracle.rs from tests/common/corpus.rs — do not edit
// corpus node `trapezoid`: HlslShader::transpile(.., Hardcoded)
float _trap_ds(float px, float py, float ax, float ay, float bx, float by) {
    precise float dx = bx - ax;
    precise float dy = by - ay;
    precise float len_sq = dx * dx + dy * dy;
    precise float t = len_sq > 0.0 ? ((px - ax) * dx + (py - ay) * dy) / len_sq : 0.0;
    t = clamp(t, 0.0, 1.0);
    precise float cx = ax + dx * t;
    precise float cy = ay + dy * t;
    precise float alice_r = sqrt((px - cx) * (px - cx) + (py - cy) * (py - cy));
    return alice_r;
}
float sdf_trapezoid(float3 p, float r1, float r2, float th, float hd) {
    precise float px = abs(p.x);
    precise float py = p.y;
    precise float he = th;
    precise float d_bot = _trap_ds(px, py, 0.0, -he, r1, -he);
    precise float d_slant = _trap_ds(px, py, r1, -he, r2, he);
    precise float d_top = _trap_ds(px, py, r2, he, 0.0, he);
    precise float d_unsigned = min(d_bot, min(d_slant, d_top));
    precise float nx = 2.0 * he;
    precise float ny = r1 - r2;
    precise float d_slant_plane = (px - r1) * nx + (py + he) * ny;
    precise float d2d = (py >= -he && py <= he && d_slant_plane <= 0.0) ? -d_unsigned : d_unsigned;
    precise float dz = abs(p.z) - hd;
    precise float2 ww = max(float2(d2d, dz), float2(0.0, 0.0));
    precise float alice_r = min(max(d2d, dz), 0.0) + length(ww);
    return alice_r;
}

float sdf_eval(float3 p) {
    precise float d0 = sdf_trapezoid(p, 0.5, 0.3, 0.2, 0.1);
    return d0;
}
