// GENERATED by examples/unreal_corpus_oracle.rs from tests/common/corpus.rs — do not edit
// corpus node `triangular_prism`: HlslShader::transpile(.., Hardcoded)
float sdf_triangular_prism(float3 p, float w, float h) {
    float3 q = abs(p);
    return max(q.z - h, max(q.x * 0.866025 + p.y * 0.5, -p.y) - w * 0.5);
}

float sdf_eval(float3 p) {
    float d0 = sdf_triangular_prism(p, 0.5, 0.15);
    return d0;
}
