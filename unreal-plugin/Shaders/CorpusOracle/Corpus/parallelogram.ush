float _para_ds(float px, float py, float ax, float ay, float bx, float by) {
    precise float dx = bx - ax;
    precise float dy = by - ay;
    precise float len_sq = dx * dx + dy * dy;
    precise float t = len_sq > 0.0 ? ((px - ax) * dx + (py - ay) * dy) / len_sq : 0.0;
    t = clamp(t, 0.0, 1.0);
    precise float cx = ax + dx * t;
    precise float cy = ay + dy * t;
    precise float alice_r = sqrt((px - cx) * (px - cx) + (py - cy) * (py - cy));
    return alice_r;
}
float _para_c2d(float px, float py, float ax, float ay, float bx, float by) {
    precise float alice_r = (px - ax) * (by - ay) - (py - ay) * (bx - ax);
    return alice_r;
}
float sdf_parallelogram(float3 p, float w, float ph, float sk, float hd) {
    precise float px = p.x;
    precise float py = p.y;
    precise float vdx = w - sk;  precise float vdy = -ph;
    precise float vax = w + sk;  precise float vay = ph;
    precise float vbx = -w + sk; precise float vby = ph;
    precise float vcx = -w - sk; precise float vcy = -ph;
    precise float d1 = _para_ds(px, py, vdx, vdy, vax, vay);
    precise float d2 = _para_ds(px, py, vax, vay, vbx, vby);
    precise float d3 = _para_ds(px, py, vbx, vby, vcx, vcy);
    precise float d4 = _para_ds(px, py, vcx, vcy, vdx, vdy);
    precise float d_unsigned = min(d1, min(d2, min(d3, d4)));
    precise float c1 = _para_c2d(px, py, vdx, vdy, vax, vay);
    precise float c2 = _para_c2d(px, py, vax, vay, vbx, vby);
    precise float c3 = _para_c2d(px, py, vbx, vby, vcx, vcy);
    precise float c4 = _para_c2d(px, py, vcx, vcy, vdx, vdy);
    precise float d2d = (c1 <= 0.0 && c2 <= 0.0 && c3 <= 0.0 && c4 <= 0.0) ? -d_unsigned : d_unsigned;
    precise float dz = abs(p.z) - hd;
    precise float2 ww = max(float2(d2d, dz), float2(0.0, 0.0));
    precise float alice_r = min(max(d2d, dz), 0.0) + length(ww);
    return alice_r;
}

float sdf_eval(float3 p) {
    precise float d0 = sdf_parallelogram(p, 0.5, 0.15, 0.2, 0.1);
