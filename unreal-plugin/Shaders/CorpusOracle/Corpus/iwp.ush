float sdf_eval(float3 p) {
    float3 d0 = p * 2.0;
    float d1 = abs(2.0 * (cos(d0.x)*cos(d0.y) + cos(d0.y)*cos(d0.z) + cos(d0.z)*cos(d0.x)) - (cos(2.0*d0.x) + cos(2.0*d0.y) + cos(2.0*d0.z))) / 2.0 - 0.1;
    return d1;
}
