float sdf_tetrahedron(float3 p, float s) {
    precise float d = dot(p, float3(0.57735026, 0.57735026, 0.57735026));
    d = max(d, dot(p, float3(-0.57735026, -0.57735026, 0.57735026)));
    d = max(d, dot(p, float3(-0.57735026, 0.57735026, -0.57735026)));
    d = max(d, dot(p, float3(0.57735026, -0.57735026, -0.57735026)));
    precise float alice_r = d - s;
    return alice_r;
}

float sdf_eval(float3 p) {
    precise float d0 = sdf_tetrahedron(p, 0.6);
    return d0;
}
