// GENERATED by examples/unreal_corpus_oracle.rs from tests/common/corpus.rs — do not edit
// corpus node `rounded_cone`: HlslShader::transpile(.., Hardcoded)
float sdf_rounded_cone(float3 p, float r1, float r2, float h) {
    precise float qx = length(p.xz);
    precise float qy = p.y + h;
    precise float ht = h * 2.0;
    precise float b = (r1 - r2) / ht;
    precise float a = sqrt(1.0 - b * b);
    precise float k = qx * (-b) + qy * a;
    if (k < 0.0) { precise float alice_r = length(float2(qx, qy)) - r1; return alice_r; }
    if (k > a * ht) { precise float alice_r = length(float2(qx, qy - ht)) - r2; return alice_r; }
    precise float alice_r = qx * a + qy * b - r1;
    return alice_r;
}

float sdf_eval(float3 p) {
    precise float d0 = sdf_rounded_cone(p, 0.4, 0.2, 0.3);
    return d0;
}
