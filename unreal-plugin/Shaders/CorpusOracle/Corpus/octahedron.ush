// corpus node `octahedron`: HlslShader::transpile(.., Hardcoded)
float sdf_octahedron(float3 p, float s) {
    precise float3 ap = abs(p);
    precise float m = ap.x + ap.y + ap.z - s;
    precise float3 q;
    if (3.0 * ap.x < m) q = ap;
    else if (3.0 * ap.y < m) q = float3(ap.y, ap.z, ap.x);
    else if (3.0 * ap.z < m) q = float3(ap.z, ap.x, ap.y);
    else { precise float alice_r = m * 0.57735027; return alice_r; }
    precise float k = clamp(0.5 * (q.z - q.y + s), 0.0, s);
    precise float alice_r = length(float3(q.x, q.y - s + k, q.z - k));
    return alice_r;
}

float sdf_eval(float3 p) {
    precise float d0 = sdf_octahedron(p, 0.6);
    return d0;
}
