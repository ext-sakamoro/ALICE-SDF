// GENERATED by examples/unreal_corpus_oracle.rs from tests/common/corpus.rs — do not edit
// corpus node `rounded_x`: HlslShader::transpile(.., Hardcoded)
float sdf_rounded_x(float3 p, float w, float r, float h) {
    precise float2 q = abs(p.xz);
    precise float s = min(q.x + q.y, w) * 0.5;
    precise float d2d = length(q - float2(s, s)) - r;
    precise float dy = abs(p.y) - h;
    precise float2 ww = max(float2(d2d, dy), float2(0.0, 0.0));
    precise float alice_r = min(max(d2d, dy), 0.0) + length(ww);
    return alice_r;
}

float sdf_eval(float3 p) {
    precise float d0 = sdf_rounded_x(p, 0.6, 0.1, 0.1);
    return d0;
}
