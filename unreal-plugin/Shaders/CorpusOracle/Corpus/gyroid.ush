float sdf_eval(float3 p) {
    float3 d1 = p * 2.0;
    float d0 = abs(sin(d1.x)*cos(d1.y) + sin(d1.y)*cos(d1.z) + sin(d1.z)*cos(d1.x)) / 2.0 - 0.1;
