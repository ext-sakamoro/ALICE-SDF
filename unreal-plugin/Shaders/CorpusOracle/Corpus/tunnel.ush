// GENERATED by examples/unreal_corpus_oracle.rs from tests/common/corpus.rs — do not edit
// corpus node `tunnel`: HlslShader::transpile(.., Hardcoded)
float sdf_tunnel(float3 p, float w, float h2d, float hd) {
    precise float px = abs(p.x);
    precise float py = p.y;
    precise float dx = px - w;
    precise float dy_rect = abs(py) - h2d;
    precise float d_rect = length(max(float2(dx, dy_rect), float2(0.0, 0.0))) + min(max(dx, dy_rect), 0.0);
    precise float d_circle = length(float2(px, py - h2d)) - w;
    precise float d2d = py > h2d ? min(d_rect, d_circle) : d_rect;
    precise float dz = abs(p.z) - hd;
    precise float2 ww = max(float2(d2d, dz), float2(0.0, 0.0));
    precise float alice_r = min(max(d2d, dz), 0.0) + length(ww);
    return alice_r;
}

float sdf_eval(float3 p) {
    precise float d0 = sdf_tunnel(p, 0.5, 0.4, 0.15);
    return d0;
}
