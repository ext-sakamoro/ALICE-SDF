float alice_loft_0(float3 p) {
    float s = alice_loft_0_cp(p);
    float3 c = alice_loft_0_pos(s);
    float3 dr = alice_loft_0_der(s);
    float3 t = normalize(dr);
    float3 nn = normalize(float3(1.0, 0.0, 0.0) - t * dot(float3(1.0, 0.0, 0.0), t));
    float3 bb = cross(t, nn);
    float3 r = p - c;
    float u = dot(r, nn);
    float v = dot(r, bb);
    float rho = sqrt(u * u + v * v);
    float c1 = 1.0;
    float s1 = 0.0;
    if (rho > 0.0) { c1 = u / rho; s1 = v / rho; }
    float g = max(rho - alice_loft_0_rad(s, c1, s1), -0.07950913);
    float d2 = g / 1.8071414;
    float3 c0 = alice_loft_0_pos(0.0);
    float3 e0 = alice_loft_0_der(0.0);
    float3 ce = alice_loft_0_pos(2.0);
    float3 ee = alice_loft_0_der(2.0);
    float dw = max(dot(c0 - p, normalize(e0)), dot(p - ce, normalize(ee)));
    float2 o = float2(max(d2, 0.0), max(dw, 0.0));
    float bigf = min(max(d2, dw), 0.0) + length(o);
    float f = bigf / 2.9804692;
    float x = bigf / alice_loft_0_lb(s);
    float sat = bigf / sqrt(1.0 + x * x);
    float dist = length(r);
    float psi = 1.0;
    f = f + (1.0 / alice_loft_0_ll(s) - 1.0 / 2.9804692) * sat * psi;
    if (f <= 0.0) { return f; }
    float xj = alice_loft_0_fb(p) - 0.4563613 - f;
    float phi = 0.0;
    if (xj > 0.0) {
        if (xj <= 0.4563613) { phi = xj * xj / (2.0 * 0.4563613); } else { phi = xj - 0.5 * 0.4563613; }
    }
    return f + phi;
}
