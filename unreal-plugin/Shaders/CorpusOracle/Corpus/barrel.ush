// GENERATED by examples/unreal_corpus_oracle.rs from tests/common/corpus.rs — do not edit
// corpus node `barrel`: HlslShader::transpile(.., Hardcoded)
float sdf_barrel(float3 p, float radius, float h, float bulge) {
    precise float r = length(p.xz);
    precise float yn = clamp(p.y / h, -1.0, 1.0);
    precise float er = radius + bulge * (1.0 - yn * yn);
    precise float dr = r - er;
    precise float dy = abs(p.y) - h;
    precise float2 w = max(float2(dr, dy), float2(0.0, 0.0));
    precise float alice_r = min(max(dr, dy), 0.0) + length(w);
    return alice_r;
}

float sdf_eval(float3 p) {
    precise float d0 = sdf_barrel(p, 0.5, 0.3, 0.2);
    return d0;
}
