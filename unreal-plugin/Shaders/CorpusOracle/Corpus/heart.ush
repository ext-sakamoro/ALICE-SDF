// GENERATED by examples/unreal_corpus_oracle.rs from tests/common/corpus.rs — do not edit
// corpus node `heart`: HlslShader::transpile(.., Hardcoded)
float sdf_heart(float3 p, float s) {
    // IQ sdHeart (2-D) revolved about Y, shifted so the centre is at the origin — same law as `sdf_heart` on the CPU.
    precise float3 sp = p / s;
    precise float qx = length(sp.xz);
    precise float qy = sp.y - 0.5;
    if (qx + qy > 1.0) {
        precise float2 e = float2(qx - 0.25, qy - 0.75);
        precise float alice_r = (sqrt(dot(e, e)) - 0.35355339) * s;
        return alice_r;
    }
    precise float2 e1 = float2(qx, qy - 1.0);
    precise float t = max(qx + qy, 0.0) * 0.5;
    precise float2 e2 = float2(qx - t, qy - t);
    precise float d = sqrt(min(dot(e1, e1), dot(e2, e2)));
    precise float alice_r = (qx > qy ? d : -d) * s;
    return alice_r;
}

float sdf_eval(float3 p) {
    precise float d0 = sdf_heart(p, 0.6);
    return d0;
}
