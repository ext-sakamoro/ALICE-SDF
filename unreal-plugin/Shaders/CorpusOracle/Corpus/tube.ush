// GENERATED by examples/unreal_corpus_oracle.rs from tests/common/corpus.rs — do not edit
// corpus node `tube`: HlslShader::transpile(.., Hardcoded)
float sdf_tube(float3 p, float outer_r, float thick, float h) {
    precise float r = length(p.xz);
    precise float dr = abs(r - outer_r) - thick;
    precise float dy = abs(p.y) - h;
    precise float2 w = max(float2(dr, dy), float2(0.0, 0.0));
    precise float alice_r = min(max(dr, dy), 0.0) + length(w);
    return alice_r;
}

float sdf_eval(float3 p) {
    precise float d0 = sdf_tube(p, 0.5, 0.1, 0.2);
    return d0;
}
