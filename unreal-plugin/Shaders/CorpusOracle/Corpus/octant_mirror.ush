// corpus node `octant_mirror`: HlslShader::transpile(.., Hardcoded)
// Octant mirror — same law as `octant_mirror` on the CPU: abs then sort descending (x ≥ y ≥ z).
float3 alice_octant_mirror(float3 p0) {
    float3 a = abs(p0);
    float x = max(a.x, a.y);
    float y = min(a.x, a.y);
    float y1 = max(y, a.z);
    float z = min(y, a.z);
    return float3(max(x, y1), min(x, y1), z);
}

float sdf_eval(float3 p) {
    float3 d0 = alice_octant_mirror(p);
    float3 d1 = d0 - float3(0.3, 0.2, 0.1);
    float3 d2 = abs(d1) - float3(0.25, 0.2, 0.15);
    float d3 = length(max(d2, float3(0.0, 0.0, 0.0))) + min(max(d2.x, max(d2.y, d2.z)), 0.0);
    return d3;
}
