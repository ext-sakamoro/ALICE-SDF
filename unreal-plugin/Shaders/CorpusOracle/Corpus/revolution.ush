// GENERATED by examples/unreal_corpus_oracle.rs from tests/common/corpus.rs — do not edit
// corpus node `revolution`: HlslShader::transpile(.., Hardcoded)
float sdf_eval(float3 p) {
    float3 d0 = float3(length(p.xz) - 0.6, p.y, 0.0);
    float d1_d2d = length(d0.xy) - 0.2;
    float d1_dz = abs(d0.z) - 0.2;
    float d1_wx = max(d1_d2d, 0.0);
    float d1_wy = max(d1_dz, 0.0);
    float d1 = sqrt(d1_wx*d1_wx + d1_wy*d1_wy) + min(max(d1_d2d, d1_dz), 0.0);
    return d1;
}
