    d = max(d, abs(dot(p, float3(0.0, 1.0, 0.0))));
    d = max(d, abs(dot(p, float3(0.0, 0.0, 1.0))));
    d = max(d, abs(dot(p, float3(0.57735026, 0.57735026, 0.57735026))));
    d = max(d, abs(dot(p, float3(-0.57735026, 0.57735026, 0.57735026))));
    d = max(d, abs(dot(p, float3(0.57735026, -0.57735026, 0.57735026))));
    d = max(d, abs(dot(p, float3(0.57735026, 0.57735026, -0.57735026))));
    return d - r;
}

float sdf_eval(float3 p) {
    float d0 = sdf_truncated_octahedron(p, 0.6);
