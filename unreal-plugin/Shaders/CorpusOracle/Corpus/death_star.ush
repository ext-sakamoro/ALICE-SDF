// GENERATED by examples/unreal_corpus_oracle.rs from tests/common/corpus.rs — do not edit
// corpus node `death_star`: HlslShader::transpile(.., Hardcoded)
float sdf_death_star(float3 p, float ra, float rb, float d) {
    precise float a = (ra * ra - rb * rb + d * d) / (2.0 * d);
    precise float b = sqrt(max(ra * ra - a * a, 0.0));
    precise float2 q = float2(p.x, length(p.yz));
    precise float alice_lhs = q.x * b - q.y * a;
    precise float alice_rhs = d * max(b - q.y, 0.0);
    if (alice_lhs > alice_rhs)
        { precise float alice_r = length(q - float2(a, b)); return alice_r; }
    precise float alice_r = max(length(q) - ra, -(length(q - float2(d, 0.0)) - rb));
    return alice_r;
}

float sdf_eval(float3 p) {
    precise float d0 = sdf_death_star(p, 0.6, 0.4, 0.5);
    return d0;
}
