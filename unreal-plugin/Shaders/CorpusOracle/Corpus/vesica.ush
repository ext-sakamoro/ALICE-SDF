// GENERATED by examples/unreal_corpus_oracle.rs from tests/common/corpus.rs — do not edit
// corpus node `vesica`: HlslShader::transpile(.., Hardcoded)
float sdf_vesica(float3 p, float r, float d) {
    // Lens of revolution about Y: 2-D vesica in (length(p.xz), |y|) — same law as `sdf_vesica` on the CPU.
    float2 q = float2(length(p.xz), abs(p.y));
    float b = sqrt(max(r * r - d * d, 0.0));
    if ((q.y - b) * d > q.x * b) return length(float2(q.x, q.y - b));
    return length(float2(q.x + d, q.y)) - r;
}

float sdf_eval(float3 p) {
    float d0 = sdf_vesica(p, 0.6, 0.15);
    return d0;
}
