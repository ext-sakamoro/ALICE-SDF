float sdf_eval(float3 p) {
    float3 d0 = p - float3(-0.5, 0.0, 0.0);
    float3 d1 = float3(0.5, 0.2, 0.0) - float3(-0.5, 0.0, 0.0);
    float d2 = clamp(dot(d0, d1) / max(dot(d1, d1), 1e-10), 0.0, 1.0);
    float d3 = length(d0 - d1 * d2) - 0.25;
    return d3;
}
