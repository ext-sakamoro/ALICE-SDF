float sdf_hex_prism(float3 p, float hex_r, float h) {
    precise float kx = -0.8660254;
    precise float ky = 0.5;
    precise float kz = 0.57735027;
    precise float px = abs(p.x);
    precise float py = abs(p.y);
    precise float pz = abs(p.z);
    precise float dot_kxy = kx * px + ky * py;
    precise float refl = 2.0 * min(dot_kxy, 0.0);
    px -= refl * kx;
    py -= refl * ky;
    precise float clamped_x = clamp(px, -kz * hex_r, kz * hex_r);
    precise float dx = px - clamped_x;
    precise float dy = py - hex_r;
    precise float d_xy = sqrt(dx * dx + dy * dy) * (dy < 0.0 ? -1.0 : 1.0);
    precise float d_z = pz - h;
    precise float alice_r = min(max(d_xy, d_z), 0.0) + length(max(float2(d_xy, d_z), float2(0.0, 0.0)));
    return alice_r;
}

float sdf_eval(float3 p) {
    precise float d0 = sdf_hex_prism(p, 0.5, 0.15);
    return d0;
}
