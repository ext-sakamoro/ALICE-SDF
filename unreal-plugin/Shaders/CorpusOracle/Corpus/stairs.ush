float _stair_box(float lx, float ly, float s, float sw, float sh) {
    precise float cx = s * sw + sw * 0.5;
    precise float hy = (s + 1.0) * sh * 0.5;
    precise float dx = abs(lx - cx) - sw * 0.5;
    precise float dy = abs(ly - hy) - hy;
    precise float alice_r = length(max(float2(dx, dy), float2(0.0, 0.0))) + min(max(dx, dy), 0.0);
    return alice_r;
}
float sdf_stairs(float3 p, float sw, float sh, float ns, float hd) {
    precise float n = max(ns, 1.0);
    precise float tw = n * sw;
    precise float th = n * sh;
    precise float lx = p.x + tw * 0.5;
    precise float ly = p.y + th * 0.5;
    precise float d2d = 1e30;
    for (precise float si = 0.0; si < n; si += 1.0) {
        d2d = min(d2d, _stair_box(lx, ly, si, sw, sh));
    }
    precise float dz = abs(p.z) - hd;
    precise float2 w = max(float2(d2d, dz), float2(0.0, 0.0));
    precise float alice_r = min(max(d2d, dz), 0.0) + length(w);
    return alice_r;
}

float sdf_eval(float3 p) {
    precise float d0 = sdf_stairs(p, 0.3, 0.2, 4.0, 0.15);
    return d0;
}
