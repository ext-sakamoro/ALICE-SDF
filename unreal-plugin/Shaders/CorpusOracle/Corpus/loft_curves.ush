float alice_loft_0(float3 p) {
    precise float s = alice_loft_0_cp(p);
    precise float3 c = alice_loft_0_pos(s);
    precise float3 dr = alice_loft_0_der(s);
    precise float3 t = normalize(dr);
    precise float3 nn = normalize(float3(1.0, 0.0, 0.0) - t * dot(float3(1.0, 0.0, 0.0), t));
    precise float3 bb = cross(t, nn);
    precise float3 r = p - c;
    precise float u = dot(r, nn);
    precise float v = dot(r, bb);
    precise float rho = sqrt(u * u + v * v);
    precise float c1 = 1.0;
    precise float s1 = 0.0;
    if (rho > 0.0) { c1 = u / rho; s1 = v / rho; }
    precise float d2 = alice_loft_0_cd(s, float2(u, v));
    precise float3 c0 = alice_loft_0_pos(0.0);
    precise float3 e0 = alice_loft_0_der(0.0);
    precise float3 ce = alice_loft_0_pos(2.0);
    precise float3 ee = alice_loft_0_der(2.0);
    precise float dw = max(dot(c0 - p, normalize(e0)), dot(p - ce, normalize(ee)));
    precise float2 o = float2(max(d2, 0.0), max(dw, 0.0));
    precise float bigf = min(max(d2, dw), 0.0) + length(o);
    precise float f = bigf / 3.5836458;
    if (f <= 0.0) { return f; }
    precise float xj = alice_loft_0_fb(p) - 0.0050000004 - f;
    precise float phi = 0.0;
    if (xj > 0.0) {
        if (xj <= 0.0050000004) { phi = xj * xj / (2.0 * 0.0050000004); } else { phi = xj - 0.5 * 0.0050000004; }
    }
    { precise float alice_ret = f + phi; return alice_ret; }
}
float sdf_eval(float3 p) {
    precise float d1 = alice_loft_0(p);
    return d1;
}
