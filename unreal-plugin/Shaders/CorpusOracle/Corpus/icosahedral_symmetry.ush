// GENERATED by examples/unreal_corpus_oracle.rs from tests/common/corpus.rs — do not edit
// corpus node `icosahedral_symmetry`: HlslShader::transpile(.., Hardcoded)
// Icosahedral fold — same law as `icosahedral_fold` on the CPU (octant fold, 8 × sort + 3 plane reflections).
float3 alice_icosahedral_fold(float3 p0) {
    float3 p = abs(p0);
    float3 n0 = normalize(float3(0.0, 1.0, 1.618034));
    float3 n1 = normalize(float3(1.0, 1.618034, 0.0));
    float3 n2 = normalize(float3(1.618034, 0.0, 1.0));
    for (int i = 0; i < 8; i++) {
        if (p.y > p.x) p = float3(p.y, p.x, p.z);
        if (p.z > p.y) p = float3(p.x, p.z, p.y);
        if (p.y > p.x) p = float3(p.y, p.x, p.z);
        float d0 = dot(p, n0);
        if (d0 < 0.0) p -= n0 * (2.0 * d0);
        float d1 = dot(p, n1);
        if (d1 < 0.0) p -= n1 * (2.0 * d1);
        float d2 = dot(p, n2);
        if (d2 < 0.0) p -= n2 * (2.0 * d2);
    }
    return p;
}

float sdf_eval(float3 p) {
    float3 d0 = alice_icosahedral_fold(p);
    float3 d1 = d0 - float3(0.3, 0.0, 0.0);
    float3 d2 = abs(d1) - float3(0.25, 0.2, 0.15);
    float d3 = length(max(d2, float3(0.0, 0.0, 0.0))) + min(max(d2.x, max(d2.y, d2.z)), 0.0);
    return d3;
}
