// GENERATED by examples/unreal_corpus_oracle.rs from tests/common/corpus.rs — do not edit
// corpus node `link`: HlslShader::transpile(.., Hardcoded)
float sdf_link(float3 p, float le, float r1, float r2) {
    precise float qx = p.x;
    precise float qy = max(abs(p.y) - le, 0.0);
    precise float qz = p.z;
    precise float xy_len = sqrt(qx * qx + qy * qy) - r1;
    precise float alice_r = sqrt(xy_len * xy_len + qz * qz) - r2;
    return alice_r;
}

float sdf_eval(float3 p) {
    precise float d0 = sdf_link(p, 0.2, 0.3, 0.1);
    return d0;
}
