// GENERATED by examples/unreal_corpus_oracle.rs from tests/common/corpus.rs — do not edit
// corpus node `link`: HlslShader::transpile(.., Hardcoded)
float sdf_link(float3 p, float le, float r1, float r2) {
    float qx = p.x;
    float qy = max(abs(p.y) - le, 0.0);
    float qz = p.z;
    float xy_len = sqrt(qx * qx + qy * qy) - r1;
    return sqrt(xy_len * xy_len + qz * qz) - r2;
}

float sdf_eval(float3 p) {
    float d0 = sdf_link(p, 0.2, 0.3, 0.1);
    return d0;
}
