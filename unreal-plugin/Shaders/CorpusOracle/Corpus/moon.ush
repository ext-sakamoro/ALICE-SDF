// GENERATED by examples/unreal_corpus_oracle.rs from tests/common/corpus.rs — do not edit
// corpus node `moon`: HlslShader::transpile(.., Hardcoded)
float sdf_moon(float3 p, float d, float ra, float rb, float h) {
    precise float qx = abs(p.x);
    precise float qz = p.z;
    precise float d_outer = length(float2(qx, qz)) - ra;
    precise float d_inner = length(float2(qx - d, qz)) - rb;
    precise float d2d = max(d_outer, -d_inner);
    precise float dy = abs(p.y) - h;
    precise float2 ww = max(float2(d2d, dy), float2(0.0, 0.0));
    precise float alice_r = min(max(d2d, dy), 0.0) + length(ww);
    return alice_r;
}

float sdf_eval(float3 p) {
    precise float d0 = sdf_moon(p, 0.3, 0.6, 0.5, 0.1);
    return d0;
}
