// GENERATED by examples/unreal_corpus_oracle.rs from tests/common/corpus.rs — do not edit
// corpus node `diamond`: HlslShader::transpile(.., Hardcoded)
float sdf_diamond(float3 p, float r, float h) {
    precise float2 q = float2(length(p.xz), abs(p.y));
    precise float2 ba = float2(-r, h);
    precise float2 qa = q - float2(r, 0.0);
    precise float t = clamp(dot(qa, ba) / dot(ba, ba), 0.0, 1.0);
    precise float2 closest = float2(r, 0.0) + ba * t;
    precise float dist = length(q - closest);
    precise float alice_lhs = q.x * h + q.y * r;
    precise float alice_rhs = r * h;
    if (alice_lhs < alice_rhs) return -dist;
    return dist;
}

float sdf_eval(float3 p) {
    precise float d0 = sdf_diamond(p, 0.5, 0.35);
    return d0;
}
