// GENERATED by examples/unreal_corpus_oracle.rs from tests/common/corpus.rs — do not edit
// corpus node `segment_2d`: HlslShader::transpile(.., Hardcoded)
float sdf_eval(float3 p) {
    float2 d0_pa = p.xy - float2(-0.5, -0.2);
    float2 d0_ba = float2(0.5, 0.3) - float2(-0.5, -0.2);
    float d0_h = clamp(dot(d0_pa, d0_ba) / dot(d0_ba, d0_ba), 0.0, 1.0);
    float d0_d2d = length(d0_pa - d0_ba * d0_h) - 0.1;
    float d0_dz = abs(p.z) - 0.5;
    float d0_wx = max(d0_d2d, 0.0);
    float d0_wy = max(d0_dz, 0.0);
    float d0 = sqrt(d0_wx*d0_wx + d0_wy*d0_wy) + min(max(d0_d2d, d0_dz), 0.0);
    return d0;
}
