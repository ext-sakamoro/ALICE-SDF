// GENERATED by examples/unreal_corpus_oracle.rs from tests/common/corpus.rs — do not edit
// corpus node `cut_sphere`: HlslShader::transpile(.., Hardcoded)
float sdf_cut_sphere(float3 p, float r, float h) {
    precise float w = sqrt(max(r * r - h * h, 0.0));
    precise float2 q = float2(length(p.xz), p.y);
    precise float s = max((h - r) * q.x * q.x + w * w * (h + r - 2.0 * q.y), h * q.x - w * q.y);
    if (s < 0.0) { precise float alice_r = length(q) - r; return alice_r; }
    if (q.x < w) { precise float alice_r = h - q.y; return alice_r; }
    precise float alice_r = length(q - float2(w, h));
    return alice_r;
}

float sdf_eval(float3 p) {
    precise float d0 = sdf_cut_sphere(p, 0.6, 0.2);
    return d0;
}
