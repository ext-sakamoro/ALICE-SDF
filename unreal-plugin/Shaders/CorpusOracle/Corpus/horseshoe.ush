// GENERATED by examples/unreal_corpus_oracle.rs from tests/common/corpus.rs — do not edit
// corpus node `horseshoe`: HlslShader::transpile(.., Hardcoded)
float sdf_horseshoe(float3 pos, float an, float r, float le, float w, float t) {
    precise float2 c = float2(cos(an), sin(an));
    precise float px = abs(pos.x);
    precise float l = length(float2(px, pos.y));
    precise float qx = -c.x * px + c.y * pos.y;
    precise float qy = c.y * px + c.x * pos.y;
    if (!(qy > 0.0 || qx > 0.0)) { qx = l * sign(-c.x); }
    if (!(qx > 0.0)) { qy = l; }
    precise float bx = qx - le;
    precise float by = abs(qy - r) - w;
    precise float d2 = length(max(float2(bx, by), float2(0.0, 0.0))) + min(max(bx, by), 0.0);
    precise float dz = abs(pos.z) - t;
    precise float alice_r = length(max(float2(d2, dz), float2(0.0, 0.0))) + min(max(d2, dz), 0.0);
    return alice_r;
}

float sdf_eval(float3 p) {
    precise float d0 = sdf_horseshoe(p, 0.8, 0.5, 0.15, 0.1, 0.2);
    return d0;
}
