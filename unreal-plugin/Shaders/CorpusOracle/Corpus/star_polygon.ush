// GENERATED by examples/unreal_corpus_oracle.rs from tests/common/corpus.rs — do not edit
// corpus node `star_polygon`: HlslShader::transpile(.., Hardcoded)
float alice_atan2(float y, float x) {
    bool sy = asint(y) < 0;
    bool sx = asint(x) < 0;
    float r = atan2(y, x);
    r = (x == 0.0) ? (sy ? -1.5707964 : 1.5707964) : r;
    r = (y == 0.0) ? (sx ? (sy ? -3.1415927 : 3.1415927) : y) : r;
    return r;
}

float sdf_star_polygon(float3 p, float radius, float np, float m, float hh) {
    float qx = abs(p.x);
    float qz = p.z;
    float n = max(np, 3.0);
    float an = 3.14159265358979 / n;
    float r = length(float2(qx, qz));
    float angle = alice_atan2(qx, qz);
    angle = fmod(fmod(angle, 2.0 * an) + 2.0 * an, 2.0 * an);
    if (angle > an) angle = 2.0 * an - angle;
    float2 pt = float2(r * cos(angle), r * sin(angle));
    float2 a = float2(radius, 0.0);
    float2 b = float2(m * cos(an), m * sin(an));
    float2 ab = b - a;
    float2 ap = pt - a;
    float t = clamp(dot(ap, ab) / dot(ab, ab), 0.0, 1.0);
    float2 closest = a + ab * t;
    float dist = length(pt - closest);
    float cross_val = ab.x * ap.y - ab.y * ap.x;
    float d2d = (cross_val > 0.0) ? -dist : dist;
    float dy = abs(p.y) - hh;
    float2 w = max(float2(d2d, dy), float2(0.0, 0.0));
    return min(max(d2d, dy), 0.0) + length(w);
}

float sdf_eval(float3 p) {
    float d0 = sdf_star_polygon(p, 0.6, 5.0, 0.3, 0.1);
    return d0;
}
