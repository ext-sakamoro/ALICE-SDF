<Project Sdk="Microsoft.NET.Sdk">
  <!-- Host-side check of the Mochi UdonSharp collider: compiles it against
       UnityEngineStub.cs (no Unity), then compares EvaluateSdf with the
       alice_sdf golden and replays a grab / split / release / merge scenario.
       Run via scripts/vrchat-host-parity.sh. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <!-- UdonSharp accepts C# 7.3; anything newer here would not compile in Unity -->
    <LangVersion>7.3</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Samples~/SDF Gallery/SampleMochi/SampleMochi_Collider.cs" Link="SampleMochi_Collider.cs" />
  </ItemGroup>
</Project>
