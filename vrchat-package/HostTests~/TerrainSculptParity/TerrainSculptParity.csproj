<Project Sdk="Microsoft.NET.Sdk">
  <!-- Host-side check of the TerrainSculpt UdonSharp collider: compiles it
       against ../Shared/UnityEngineStub.cs (no Unity), records the sculpt
       operations of examples/vrchat_terrain_sculpt_golden.rs and compares
       EvaluateSdf with that golden, then replays a sculpt / stand / dig /
       bury / wall scenario. Run via scripts/vrchat-host-parity.sh. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <!-- UdonSharp accepts C# 7.3; anything newer here would not compile in Unity -->
    <LangVersion>7.3</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Samples~/SDF Gallery/SampleTerrainSculpt/SampleTerrainSculpt_Collider.cs" Link="SampleTerrainSculpt_Collider.cs" />
    <Compile Include="../Shared/UnityEngineStub.cs" Link="UnityEngineStub.cs" />
  </ItemGroup>
</Project>
